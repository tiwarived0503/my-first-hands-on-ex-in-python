for value in range(1,11):
    print(value)

#list of numbers
numbers = list(range(1,11))
print(numbers)

#list of odd numbers
nums = list(range(1,12,2))
# >>> range is from 1 to 12 and adding 2 everytime 
print(nums)

#list of squares from 1 to 10
squares = []
for counting in range(1,11):
    squares.append(counting**2)
print(squares) 

#Simple statistics with list of numbers
digits = list(range(0,10))
print(min(digits))
print(max(digits))
print(sum(digits))

#List Comprehensions
#The approach described earlier for generating the list squares consisted of 
#using three or four lines of code. A list comprehension allows you to generate 
#this same list in just one line of code
set = [digi**2 for digi in range(1,11)]
print(set)